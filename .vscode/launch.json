{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "train",
            "type": "debugpy",
            "request": "launch",
            "module": "gaussian_splatting.train",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "data/truck",
                "-d",
                "output/truck",
                "-i",
                "30000",
                "--mode",
                "densify",
                // "normal-densify",
                // "--backend",
                // "gsplat-2dgs",
                "--empty_cache_every_step",
                "-odensify_grad_threshold=0.0001",
            ]
        },
        {
            "name": "train 2dgs",
            "type": "debugpy",
            "request": "launch",
            "module": "gaussian_splatting.train",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "data/truck",
                "-d",
                "output/truck-2dgs",
                "-i",
                "30000",
                "--mode",
                "normal-densify",
                "--backend",
                "gsplat-2dgs",
                "--empty_cache_every_step",
                "-oopacity_lr=0.05",
                "-oprune_from_iter=500",
                "-oprune_percent_too_big=0.1",
                "-oprune_opacity_threshold=0.05",
            ]
        },
        {
            "name": "train camera",
